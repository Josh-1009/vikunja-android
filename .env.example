# ==============================================================================
# VIKUNJA PRODUCTION CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HOSTING, DOMAIN & SECURITY (Checklist #1)
# ------------------------------------------------------------------------------
# Must be your full public domain with HTTPS and trailing slash "/"
VIKUNJA_PUBLIC_URL=https://tasks.yourcompany.com/

# Secret token for signing JWT tokens (generate with: openssl rand -base64 32)
VIKUNJA_JWT_SECRET=replace_with_32_plus_random_characters_secret

# Timezone for dates/reminders (e.g., UTC, America/New_York, Europe/London, Asia/Dubai, etc.)
TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 2. ACCESS CONTROL & REGISTRATION LOCK (Checklist #3)
# ------------------------------------------------------------------------------
# Set to 'true' during initial admin signup, then change to 'false' to lock registration!
ENABLE_REGISTRATION=true

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
DB_USER=vikunja
DB_NAME=vikunja
# Generate with: openssl rand -hex 16
DB_PASSWORD=replace_with_strong_database_password

# ------------------------------------------------------------------------------
# 4. INSTANT NOTIFICATION SYSTEM / SMTP MAILER (Checklist #2)
# ------------------------------------------------------------------------------
# Set MAIL_ENABLED to true once your SMTP details are entered
MAIL_ENABLED=false
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
# Authentication type: 'plain', 'login', or 'cram-md5'
MAIL_AUTHTYPE=plain
MAIL_USER=postmaster@tasks.yourcompany.com
MAIL_PASSWORD=your_smtp_api_key_or_password
MAIL_FROM=Vikunja Tasks <noreply@yourcompany.com>
# Set MAIL_FORCESSL to true if using Port 465 (SSL). Use false for Port 587 (STARTTLS).
MAIL_FORCESSL=false

# ------------------------------------------------------------------------------
# 5. VIKUNJA MCP SERVER CONFIGURATION (Multi-User RBAC)
# ------------------------------------------------------------------------------
# Root API endpoint for Vikunja (with /api/v1)
VIKUNJA_API_URL=http://localhost:3456/api/v1

# Path to the JSON file storing user mappings and tokens
USERS_CONFIG_PATH=users.json

# MCP Server Transport and Network Options
MCP_TRANSPORT=stdio
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
LOG_LEVEL=INFO
